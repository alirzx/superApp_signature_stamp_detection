# Module 06 local development. Copy to .env; never commit real credentials.
APP_ENV=development
API_TOKEN=
API_BIND_IP=127.0.0.1
API_PORT=8006
UI_BIND_IP=127.0.0.1
UI_PORT=8087
# Exact pinned Wiki checkpoint (369 MB), no floating revision.
MODEL_REPO=bluecopa/rf-detr-stamp-signature-detector
MODEL_REVISION=c59fd4f451b254501700a56c7769f1a3d788c753
MODEL_FILENAME=checkpoint_best_ema.pth
MODEL_SHA256=3a831ae093be64a01a4d9c635dc6071ad7c43c3e95c3da0b33a17351df1e7909
CPU_THREADS=2
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000
MAX_REQUEST_BYTES=12582912
PREPROCESS_MAX_LONG_EDGE=2500
SCORE_THRESHOLD=0.50
ENABLE_METRICS=true
# Provisional CPU budgets: NOT measured requirements, benchmark on target hardware.
API_CPUS=2.0
API_MEMORY=4g
UI_CPUS=0.5
UI_MEMORY=256m
SETUP_CPUS=2.0
SETUP_MEMORY=1g
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
NPM_REGISTRY_URL=https://package-mirror.liara.ir/repository/npm/
NPM_FALLBACK_REGISTRY_URL=https://registry.npmjs.org/
APK_PRIMARY_MIRROR_URL=https://linux-mirror.liara.ir/repository/alpine
APK_FALLBACK_MIRROR_URL=https://mirrors.huaweicloud.com/alpine
APT_PRIMARY_DEBIAN_URL=https://mirror.metanet.ch/debian
APT_PRIMARY_SECURITY_URL=https://mirror.metanet.ch/debian-security
APT_FALLBACK_DEBIAN_URL=https://mirrors.huaweicloud.com/repository/debian
APT_FALLBACK_SECURITY_URL=https://mirrors.huaweicloud.com/repository/debian-security
HF_HUB_ETAG_TIMEOUT=30
HF_HUB_DOWNLOAD_TIMEOUT=300